<?xml version="1.0" encoding="utf-8"?>
<!-- One app tile: 16:9 banner with the name underneath (shown only while focused). -->
<net.cleanhome.launcher.TileView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/banner"
        android:layout_width="@dimen/grid_tile_w"
        android:layout_height="@dimen/grid_tile_h"
        android:scaleType="centerCrop"
        android:background="@drawable/tile_placeholder"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/label"
        android:layout_width="@dimen/grid_tile_w"
        android:layout_height="@dimen/tile_label_height"
        android:gravity="center"
        android:paddingTop="6dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/tile_label_size"
        android:singleLine="true"
        android:ellipsize="end"
        android:alpha="0" />
</net.cleanhome.launcher.TileView>
